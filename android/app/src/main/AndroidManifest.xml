<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ApexOverdriveApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:appCategory="game">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Live AdMob app id (Red Pen Studio). Debug and dev builds still request Google's test
             ad units (src/config.js), which is the supported way to test with a real app id. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1848535996024012~6089611565" />

        <!-- Meta (Facebook) SDK: app-install and app-open measurement for Meta app ads only.
             Everything starts switched off and the SDK's own init provider is removed below.
             ApexOverdriveApplication starts it at app start, and MetaMeasurementPlugin again after
             each UMP check, only when the stored Google UMP consent answer allows it
             (meta/MetaConsentPolicy.java). Screen titles, AppLink URLs, "product improvement"
             data and SDK diagnostics stay off for everyone. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogMetaDataEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogProductImprovementEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.MonitorEnabled"
            android:value="false" />
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Required by the Capacitor WebView bridge; gameplay itself never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Meta SDK core (install attribution only): it may look up the Facebook app's attribution
         ID provider, Meta's documented setup. No other app is queried. -->
    <queries>
        <package android:name="com.facebook.katana" />
    </queries>

    <!-- The Meta SDK also asks for Privacy Sandbox custom audiences (remarketing). This app uses
         Meta for install / app-open measurement only, so that permission is left out. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE"
        tools:node="remove" />

    <!-- OpenGL ES 3.0 (WebGL2) for the 3D renderer. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
</manifest>
