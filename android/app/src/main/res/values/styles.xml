<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Dark, so nothing white can flash behind the game. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Theme the WebView activity runs under (Capacitor's BridgeActivity applies it).
         The SystemBars plugin paints the decor view with windowBackground, so it must be black.
         No bar colours or cutout mode here: those attributes are deprecated in Android 15 and
         MainActivity gets the same result from EdgeToEdge.enable (values-v30 sets "always"). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Launch theme: black background with the app icon (Android 12+ system splash) and the
         dark brand splash on older versions. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
