+// PILOT (temporary, not committed): the formula car's own mirror glass (material MirrorGlass,
+// uv 0..1 per glass) shows the cockpit's live rear view on mid/high tiers and a sky gradient on
+// low, like the shared cabin's mirrors.
+function pilotMirrorGlass(root, cockpit) {
+  const glass = [];
+  root.traverse((o) => o.isMesh && o.material?.name === 'MirrorGlass' && glass.push(o));
+  for (const o of glass) {
+    const g = o.geometry.clone();
+    const uv = g.attributes.uv;
+    if (cockpit.liveMirror) {
+      for (let i = 0; i < uv.count; i++) uv.setX(i, 1 - uv.getX(i));
+      o.material = new THREE.MeshBasicMaterial({ map: cockpit.mirrorTarget.texture });
+    } else {
+      const col = new Float32Array(uv.count * 3);
+      const top = new THREE.Color(0xa9bfd3), low = new THREE.Color(0x4b545e), c = new THREE.Color();
+      for (let i = 0; i < uv.count; i++) {
+        c.copy(low).lerp(top, Math.min(1, Math.max(0, uv.getY(i))));
+        col.set([c.r, c.g, c.b], i * 3);
+      }
+      g.setAttribute('color', new THREE.BufferAttribute(col, 3));
+      o.material = new THREE.MeshBasicMaterial({ vertexColors: true });
+    }
+    o.geometry = g;
+  }
+  return glass;
+}
